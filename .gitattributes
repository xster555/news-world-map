# 仓库里统一以 LF 存储文本。
# 原因：Windows 上 core.autocrlf=true 时，检出后 .sh 会变成 CRLF，
# 在 Linux/macOS 上执行会报「/bin/sh^M: bad interpreter」。
* text=auto eol=lf

# Windows 批处理保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp4 binary
*.woff binary
*.woff2 binary
