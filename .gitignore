__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/

# ---- 编辑器 / IDE ----
.vscode/
.idea/
*.swp
*.swo

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---- 打包产物 ----
*.zip
*.tar.gz
*.7z
